{
	"include": ["env.d.ts", "**/*.ts", "**/*.tsx", "**/**/.server/**/*.ts", "./eslint.config.mjs",".react-router/types/**/*"],
	"exclude": ["extensions"],
	"compilerOptions": {
		"types": ["vitest/globals", "@vitest/browser/providers/playwright","@react-router/node", "vite/client"],
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"isolatedModules": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"target": "ES2023",
		"strict": true,
		"allowJs": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"~/*": ["./app/*"],
			"@/*": ["./app/*"]
		},
		"rootDirs": [".", "./.react-router/types"],
		"plugins": [{ "name": "@react-router/dev" }],
		// Vite takes care of building everything, not tsc.
		"noEmit": true
	}
}