    "@react-router/node": "7.1.1",
    "@shopify/polaris": "^13.9.2",
    "@shopify/polaris-icons": "9.3.0",
    "@shopify/shopify-app-remix": "^3.6.0",
    "class-variance-authority": "0.7.1",
