    "isbot": "5.1.20",
    "pino": "9.6.0",
    "pretty-cache-header": "1.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "15.4.0",
    "react-router": "7.1.1",
    "react-router-hono-server": "2.6.4",
    "remix-hono": "0.0.18",
    "remix-i18next": "7.0.2",
